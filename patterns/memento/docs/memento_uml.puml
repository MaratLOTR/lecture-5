@startuml
allowmixing
top to bottom direction
skinparam backgroundColor white
skinparam monochrome true
skinparam shadowing false
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam classHeaderBackgroundColor white
skinparam rectangleBackgroundColor white
skinparam noteBackgroundColor white
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
hide circle

class SceneSettings <<Originator>> {
 -brightness
 -target_temperature
 -devices
 +save(): SceneSnapshot
 +restore(snapshot)
}
class SceneSnapshot <<Memento>> {
 -saved_state
}
class History <<Caretaker>> {
 -undo_stack
 -redo_stack
 +undo()
 +redo()
}
SceneSettings ..> SceneSnapshot : создаёт
History o--> "0..*" SceneSnapshot : хранит
History --> SceneSettings : save() / restore()
note bottom of SceneSnapshot
 Независимый снимок данных
 История не меняет его содержимое
end note

@enduml
